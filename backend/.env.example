# Copy to .env and fill in real values.
#
# IMPORTANT: use a SEPARATE Supabase project, Qdrant collection and OpenRouter
# key for local development. Never point a dev process at production data.
# See docs/ENVIRONMENTS.md for the full setup.

# LOCAL DEV: orgbrain-dev project (ref pgjnqchstqqjlnnkrugp).
# PRODUCTION uses thmrzulqsahxzkvqqvxu — set only in Railway, never here.
# Supabase project URL (also used to derive the JWKS endpoint for JWT verification)
SUPABASE_URL=https://pgjnqchstqqjlnnkrugp.supabase.co
# Supabase anon (public) key — from orgbrain-dev dashboard → Settings → API
SUPABASE_KEY=
# Supabase Auth uses asymmetric JWT signing keys (ES256). The backend verifies
# tokens against the public JWKS at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# so no shared secret is required.

# Postgres connection string (Supabase pooler)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Auto-create/alter the schema from entities. true is OK against orgbrain-dev
# (empty throwaway DB). Force-disabled in production regardless of this value.
DB_SYNCHRONIZE=true

# Qdrant vector store
QDRANT_URL=
QDRANT_API_KEY=
# Collection name — MUST differ per environment so vectors never mix.
# Local dev: orgbrain_dev | Production (Railway): orgbrain_knowledge
QDRANT_COLLECTION=orgbrain_dev

# OpenRouter LLM gateway (use a dedicated dev key with a low spend limit)
OPENROUTER_API_KEY=

CHAT_MODEL=google/gemma-2-9b-it:free
EMBEDDING_MODEL=local

# development | staging | production
APP_ENV=development
SECRET_KEY=change-me

# Comma-separated CORS allow-list, e.g. https://app.example.com,https://example.com
# Leave unset locally; SET IT in production to your frontend domain(s).
CORS_ORIGINS=
# Max Reflect runs per organisation per UTC day (LLM cost guard). 0 = unlimited.
REFLECT_DAILY_LIMIT=50

# Sentry error monitoring (optional). Leave empty to disable — no events are
# sent. Set the backend DSN in staging/production to capture server errors.
SENTRY_DSN=
# Share of requests traced for performance (0..1). 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1
