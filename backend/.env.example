# Copy to .env and fill in real values

# Supabase project URL (also used to derive the JWKS endpoint for JWT verification)
SUPABASE_URL=https://your-project.supabase.co
# Supabase anon (public) key
SUPABASE_KEY=
# Supabase Auth uses asymmetric JWT signing keys (ES256). The backend verifies
# tokens against the public JWKS at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# so no shared secret is required.

# Postgres connection string (Supabase pooler)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Qdrant vector store
QDRANT_URL=
QDRANT_API_KEY=

# OpenRouter LLM gateway
OPENROUTER_API_KEY=

CHAT_MODEL=google/gemma-2-9b-it:free
EMBEDDING_MODEL=local

APP_ENV=development
SECRET_KEY=change-me
